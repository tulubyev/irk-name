---
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/600.css';
import '@fontsource/playfair-display/700.css';
import '../styles/global.css';
import { SITE } from '../lib/persons';
import { COPYRIGHT_YEARS } from '../lib/operator';
import Babr from '../components/Babr.astro';
import { BRAND, VERIFICATION, METRIKA_ID } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'profile' | 'article';
  image?: string;
  /** Один или несколько блоков schema.org */
  jsonLd?: object | object[];
  /** Готовый <title>, без добавления названия сайта */
  fullTitle?: string;
  /** Не индексировать страницу (служебные страницы) */
  noindex?: boolean;
}
const {
  title,
  description = 'Знаменитые люди Иркутска и Иркутской области: учёные, писатели, декабристы, купцы, врачи, военные — биографии с источниками.',
  type = 'website',
  image,
  jsonLd,
  fullTitle: fullTitleProp,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const fullTitle = fullTitleProp ?? (Astro.url.pathname === '/' ? title : `${title} — ${BRAND}`);
const ogImage = image ?? new URL('/og.png', SITE).href;
const defaultImage = !image; // og.png — 1200×630
const metrikaScript = `window.addEventListener('load', function () {
  (function (m, e, t, r, i, k, a) { m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); }; m[i].l = 1 * new Date();
    k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a); })
  (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
  ym(${Number(METRIKA_ID)}, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
});`;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://cdn.irk.name" crossorigin />
    <meta name="theme-color" content="#7a2e2e" />
    {VERIFICATION.yandex && <meta name="yandex-verification" content={VERIFICATION.yandex} />}
    {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {defaultImage && <meta property="og:image:width" content="1200" />}
    {defaultImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={defaultImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLdBlocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
    {METRIKA_ID && <script is:inline set:html={metrikaScript} />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/">
          <Babr />
          <span class="logo-text"><span class="logo-name">Иркутяне</span><span class="logo-tag">Знаменитые имена нашей земли</span></span>
        </a>
        <a class="suggest" href="/predlozhit/">Предложить<span class="long"> персону</span></a>
        <button class="theme" id="theme-toggle" type="button" aria-label="Переключить тему"><span class="long">Тема</span><span class="short" aria-hidden="true">◐</span></button>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <span class="footer-copy">© {COPYRIGHT_YEARS} irk.name</span>
        <nav aria-label="Служебные ссылки">
          <a href="/o-proekte/">О проекте</a>
          <a href="/predlozhit/">Предложить персону</a>
          <a href="/politika-konfidencialnosti/">Политика конфиденциальности</a>
          <a href="/personalnye-dannye/">Персональные данные</a>
        </nav>
      </div>
    </footer>
    {METRIKA_ID && (
      <div class="cookie-note" id="cookie-note" role="region" aria-label="Уведомление о cookie" hidden>
        <p>Сайт использует Яндекс.Метрику (файлы cookie) для анонимной статистики посещений. Запись действий посетителей не ведётся. <a href="/politika-konfidencialnosti/">Подробнее</a></p>
        <button type="button" id="cookie-ok">Понятно</button>
      </div>
    )}
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
    {METRIKA_ID && (
      <script is:inline>
        (function () {
          var box = document.getElementById('cookie-note');
          var seen = false;
          try { seen = localStorage.getItem('cookie-note') === '1'; } catch (e) {}
          if (!seen && box) box.hidden = false;
          var ok = document.getElementById('cookie-ok');
          if (ok) ok.addEventListener('click', function () {
            box.hidden = true;
            try { localStorage.setItem('cookie-note', '1'); } catch (e) {}
          });
        })();
      </script>
    )}
  </body>
</html>
