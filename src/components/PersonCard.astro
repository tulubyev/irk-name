---
import { SPHERES, DISTRICTS, SPHERE_FAMILY } from '../lib/taxonomy';
import { lifespan, districtsOf, settlementsOf, type Person } from '../lib/persons';
interface Props { person: Person }
const { person } = Astro.props;
const d = person.data;
const districts = districtsOf(d);
const search = [
  d.name,
  d.summary,
  ...d.spheres.map((s) => SPHERES[s]),
  ...d.places.map((p) => p.name),
  ...settlementsOf(d),
  ...districts.map((k) => DISTRICTS[k]),
]
  .join(' ')
  .toLowerCase()
  .replaceAll('ё', 'е');
---
<li class={`card fam-${SPHERE_FAMILY[d.spheres[0]]}`} data-search={search} data-spheres={d.spheres.join(" ")} data-era={d.era} data-districts={districts.join(" ")}>
  <h3><a href={`/persona/${person.id}/`}>{d.name}</a></h3>
  <div class="years">{lifespan(d)}</div>
  <p>{d.summary}</p>
  <ul class="chips card-chips">
    {d.spheres.map((s) => <li><a class={`chip fam-${SPHERE_FAMILY[s]}`} href={`/sfera/${s}/`}>{SPHERES[s]}</a></li>)}
  </ul>
</li>
