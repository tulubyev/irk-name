---
import Base from '../../layouts/Base.astro';
import { getPersons } from '../../lib/persons';
import { ERAS, type EraKey } from '../../lib/taxonomy';
const persons = await getPersons();
const counts = (Object.keys(ERAS) as EraKey[])
  .map((k) => ({ k, n: persons.filter((p) => p.data.era === k).length }))
  .filter((x) => x.n > 0);
---
<Base title="Времена" description="Знаменитые люди Иркутска и Иркутской области по векам: от XVII века до наших дней — биографии с источниками.">
  <h1>Времена</h1>
  <ul class="chips">
    {counts.map(({ k, n }) => <li><a class="chip" href={`/epoha/${k}/`}>{ERAS[k]} · {n}</a></li>)}
  </ul>
</Base>
