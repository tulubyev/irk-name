---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getPersons } from '../../lib/persons';
import { SPHERES, type SphereKey } from '../../lib/taxonomy';
import { SITE } from '../../lib/persons';
import { biographies, clip, namesOf, collectionLd, breadcrumbLd, BRAND } from '../../lib/seo';
export async function getStaticPaths() {
  const persons = await getPersons();
  return (Object.keys(SPHERES) as SphereKey[])
    .map((k) => ({ params: { sphere: k }, props: { list: persons.filter((p) => p.data.spheres.includes(k)) } }))
    .filter((x) => x.props.list.length > 0);
}
const { sphere } = Astro.params;
const { list } = Astro.props;
const label = SPHERES[sphere as SphereKey];
const url = `${SITE}/sfera/${sphere}/`;
const description = clip(`${label} Иркутска и Иркутской области: ${biographies(list.length)} — ${namesOf(list)} и другие. Годы жизни, чем известны, источники.`);
const jsonLd = [
  collectionLd({ name: label, url, description, persons: list }),
  breadcrumbLd([{ name: 'Все имена', url: `${SITE}/` }, { name: 'Сферы', url: `${SITE}/sfera/` }, { name: label, url }]),
];
---
<Base title={label} fullTitle={`${label} Иркутска — знаменитые люди | ${BRAND}`} description={description} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/sfera/">Сферы</a> › {label}</nav>
  <h1>{label}</h1>
  <p class="lead">{biographies(list.length)} знаменитых людей Иркутска и Иркутской области в категории «{label}»: годы жизни, чем известен каждый и источники — на страницах персон.</p>
  <ul class="cards">{list.map((p) => <PersonCard person={p} />)}</ul>
</Base>
