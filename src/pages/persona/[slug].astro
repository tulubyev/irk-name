---
import Base from '../../layouts/Base.astro';
import { getPersons, lifespan, SITE } from '../../lib/persons';
import { SPHERES, ERAS, CONNECTIONS, STATUS, DISTRICTS } from '../../lib/taxonomy';
import { render } from 'astro:content';
import { mediaUrl, mediaSrcset } from '../../lib/media';
import PersonCard from '../../components/PersonCard.astro';
import { personTitle, relatedTo, profileLd, breadcrumbLd, clip, BRAND } from '../../lib/seo';

export async function getStaticPaths() {
  const persons = await getPersons();
  return persons.map((p) => ({ params: { slug: p.id }, props: { person: p } }));
}
const { person } = Astro.props;
const d = person.data;
const { Content } = await render(person);
const url = `${SITE}/persona/${person.id}/`;
const title = personTitle(d);
const all = await getPersons();
const related = relatedTo(person, all);
const jsonLd = [
  profileLd(person, url, title),
  breadcrumbLd([
    { name: 'Все имена', url: `${SITE}/` },
    { name: d.name, url },
  ]),
];
---
<Base title={d.name} fullTitle={`${title} | ${BRAND}`} description={clip(d.summary, 300)} type="profile" image={d.photo ? mediaUrl(d.photo.key) : undefined} jsonLd={jsonLd}>
  <nav class="breadcrumbs"><a href="/">Все имена</a> › {d.name}</nav>
  <article class="prose">
    <h1>{d.name}</h1>
    <p class="lead">{lifespan(d)} · {ERAS[d.era]}</p>
    {d.status === 'needs-check' && (
      <p class="notice">Статус: <strong>{STATUS['needs-check']}</strong>. Данные приведены по общедоступным источникам и ещё не сверены полностью.</p>
    )}
    {d.photo && (
      <figure class="photo">
        <img src={mediaUrl(d.photo.key)} srcset={mediaSrcset(d.photo.key)} sizes="(max-width: 26rem) 100vw, 24rem" alt={d.photo.alt} loading="lazy" decoding="async" onerror="this.closest('figure').hidden=true" />
        <figcaption>
          {d.photo.caption && <>{d.photo.caption}. </>}
          Автор: {d.photo.author}. Лицензия:{' '}
          {d.photo.licenseUrl ? <a href={d.photo.licenseUrl}>{d.photo.license}</a> : d.photo.license}.
          {d.photo.sourceUrl && <a href={d.photo.sourceUrl}> Источник</a>}
        </figcaption>
      </figure>
    )}
    <p>{d.summary}</p>
    <Content />
    {(d.gallery ?? []).length > 0 && (
      <>
        <h2>Фотографии</h2>
        <div class="gallery">
          {d.gallery.map((g) => (
            <figure class="photo">
              <a href={mediaUrl(g.key)} target="_blank" rel="noopener">
                <img src={mediaUrl(g.key.replace(/\.webp$/, '-640.webp'))} srcset={mediaSrcset(g.key)} sizes="(max-width: 40rem) 100vw, 20rem" alt={g.alt} loading="lazy" decoding="async" onerror="this.closest('figure').hidden=true" />
              </a>
              <figcaption>
                {g.caption && <>{g.caption}. </>}
                Автор: {g.author}. Лицензия:{' '}
                {g.licenseUrl ? <a href={g.licenseUrl}>{g.license}</a> : g.license}.
                {g.sourceUrl && <a href={g.sourceUrl}> Источник</a>}
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    )}
    {(d.links ?? []).length > 0 && (
      <>
        <h2>Подробнее о жизни и деятельности</h2>
        <ul class="more-links">
          {(d.links ?? []).map((l) => <li><a href={l.url} rel="noopener">{l.title}</a></li>)}
        </ul>
      </>
    )}
    <h2>Связь с Иркутском</h2>
    <dl class="facts">
      <dt>Связь</dt>
      <dd>{d.connection.map((c) => CONNECTIONS[c]).join('; ')}</dd>
      {d.connectionNote && (<><dt>Комментарий</dt><dd>{d.connectionNote}</dd></>)}
      {d.places.length > 0 && (
        <>
          <dt>Места</dt>
          <dd>
            <ul class="places">
              {d.places.map((p) => (
                <li>
                  {p.name}
                  {p.settlement && !p.name.includes(p.settlement) && <>, {p.settlement}</>}
                  {p.district && <> — <a href={`/mesto/${p.district}/`}>{DISTRICTS[p.district]}</a></>}
                </li>
              ))}
            </ul>
          </dd>
        </>
      )}
      <dt>Сферы</dt>
      <dd>{d.spheres.map((s, i) => <>{i > 0 && ', '}<a href={`/sfera/${s}/`}>{SPHERES[s]}</a></>)}</dd>
      <dt>Век</dt>
      <dd><a href={`/epoha/${d.era}/`}>{ERAS[d.era]}</a></dd>
      <dt>Проверка</dt>
      <dd>{d.status === 'verified' ? <span class="badge ok">{STATUS.verified}</span> : <span class="badge warn">{STATUS['needs-check']}</span>}</dd>
    </dl>
    <h2>Источники</h2>
    <ul>
      {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
    </ul>
    {related.length > 0 && (
      <>
        <h2>Ещё по теме</h2>
        <ul class="cards related">{related.map((p) => <PersonCard person={p} />)}</ul>
      </>
    )}
    <p class="empty">Нашли ошибку или знаете больше? <a href={`/predlozhit/?slug=${person.id}`}>Сообщите нам</a>.</p>
  </article>
</Base>
