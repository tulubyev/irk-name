---
import Base from '../../layouts/Base.astro';
import { getPersons, layersOf } from '../../lib/persons';
import { LAYERS, LAYER_RULE, type LayerKey } from '../../lib/taxonomy';
const persons = await getPersons();
const counts = (Object.keys(LAYERS) as LayerKey[]).map((k) => ({
  k,
  n: persons.filter((p) => layersOf(p.data).includes(k)).length,
}));
---
<Base title="Периоды" description="Знаменитые имена Иркутска по временным слоям: до 1917 года, до 1992 года, настоящее время.">
  <h1>Периоды</h1>
  <p class="lead">{LAYER_RULE}</p>
  <ul class="chips">
    {counts.map(({ k, n }) => <li><a class="chip" href={`/period/${k}/`} title={LAYERS[k].hint}>{LAYERS[k].label} · {n}</a></li>)}
  </ul>
</Base>
