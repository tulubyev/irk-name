---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getPersons, layersOf } from '../../lib/persons';
import { LAYERS, LAYER_RULE, type LayerKey } from '../../lib/taxonomy';
export async function getStaticPaths() {
  const persons = await getPersons();
  return (Object.keys(LAYERS) as LayerKey[]).map((k) => ({
    params: { layer: k },
    props: { list: persons.filter((p) => layersOf(p.data).includes(k)) },
  }));
}
const { layer } = Astro.params;
const { list } = Astro.props;
const meta = LAYERS[layer as LayerKey];
---
<Base title={meta.label} description={`${meta.label} (${meta.hint}) — знаменитые имена Иркутска.`}>
  <nav class="breadcrumbs"><a href="/period/">Периоды</a> › {meta.label}</nav>
  <h1>{meta.label}</h1>
  <p class="lead">{meta.hint}. {LAYER_RULE}</p>
  {list.length === 0 ? <p class="empty">Записей пока нет.</p> : <ul class="cards">{list.map((p) => <PersonCard person={p} />)}</ul>}
</Base>
