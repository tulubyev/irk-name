---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { getPersons, layersOf, districtsOf, SITE } from '../lib/persons';
import { SPHERES, LAYERS, LAYER_RULE, DISTRICTS, type SphereKey, type LayerKey, type DistrictKey } from '../lib/taxonomy';
const persons = await getPersons();
const sphereCounts = (Object.keys(SPHERES) as SphereKey[])
  .map((k) => ({ k, n: persons.filter((p) => p.data.spheres.includes(k)).length }));
const districtCounts = (Object.keys(DISTRICTS) as DistrictKey[])
  .map((k) => ({ k, n: persons.filter((p) => districtsOf(p.data).includes(k)).length }))
  .filter((x) => x.n > 0);
const layerCounts = (Object.keys(LAYERS) as LayerKey[]).map((k) => ({
  k,
  n: persons.filter((p) => layersOf(p.data).includes(k)).length,
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'irk.name',
  url: SITE,
  inLanguage: 'ru',
  description: 'Справочник знаменитых имён Иркутска',
};
---
<Base title="irk.name — знаменитые имена Иркутска" jsonLd={jsonLd}>
  <h1>Знаменитые имена Иркутска</h1>
  <p class="lead">Справочник людей, связанных с городом: уроженцев, жителей, учёных, писателей, декабристов, купцов и меценатов.</p>
  <label for="q" style="position:absolute;left:-9999px">Поиск по имени, сфере или месту</label>
  <input id="q" class="search" type="search" placeholder="Поиск: имя, сфера деятельности, место…" autocomplete="off" />

  <div class="filters">
    <div class="filter-group" role="group" aria-labelledby="f-layer">
      <span id="f-layer" class="filter-title">Период</span>
      {layerCounts.map(({ k, n }) => (
        <button type="button" class="chip toggle" data-group="layer" data-value={k} aria-pressed="false" title={LAYERS[k].hint}>
          {LAYERS[k].label} <span class="n">{n}</span>
        </button>
      ))}
      <span class="hint">{LAYER_RULE}</span>
    </div>
    <div class="filter-group" role="group" aria-labelledby="f-sphere">
      <span id="f-sphere" class="filter-title">Вид деятельности</span>
      {sphereCounts.map(({ k, n }) => (
        <button type="button" class="chip toggle" data-group="sphere" data-value={k} aria-pressed="false" disabled={n === 0} title={n === 0 ? 'Записей пока нет — предложите персону' : undefined}>
          {SPHERES[k]} <span class="n">{n}</span>
        </button>
      ))}
    </div>
    <div class="filter-group" role="group" aria-labelledby="f-district">
      <span id="f-district" class="filter-title">Район</span>
      {districtCounts.map(({ k, n }) => (
        <button type="button" class="chip toggle" data-group="district" data-value={k} aria-pressed="false">
          {DISTRICTS[k]} <span class="n">{n}</span>
        </button>
      ))}
    </div>
    <button type="button" id="reset" class="chip" hidden>Сбросить фильтры</button>
  </div>

  <p id="count" class="empty" aria-live="polite">Всего записей: {persons.length}</p>
  <ul class="cards" id="list">
    {persons.map((p) => <PersonCard person={p} />)}
  </ul>
  <p id="none" class="empty" hidden>Ничего не найдено. Попробуйте убрать часть фильтров или <a href="/predlozhit/">предложите персону</a>.</p>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var items = Array.prototype.slice.call(document.querySelectorAll('#list .card'));
      var buttons = Array.prototype.slice.call(document.querySelectorAll('button.toggle'));
      var count = document.getElementById('count');
      var none = document.getElementById('none');
      var reset = document.getElementById('reset');
      var total = items.length;
      var state = { layer: [], sphere: [], district: [] };

      function has(attr, list) {
        if (!list.length) return true;
        var vals = (attr || '').split(' ');
        return list.some(function (v) { return vals.indexOf(v) !== -1; });
      }
      function syncUrl() {
        var p = new URLSearchParams();
        if (state.layer.length) p.set('period', state.layer.join(','));
        if (state.sphere.length) p.set('sfera', state.sphere.join(','));
        if (state.district.length) p.set('rayon', state.district.join(','));
        if (q.value) p.set('q', q.value);
        var s = p.toString();
        try { history.replaceState(null, '', location.pathname + (s ? '?' + s : '')); } catch (e) {}
      }
      function apply() {
        var terms = q.value.toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean);
        var shown = 0;
        items.forEach(function (li) {
          var hay = li.getAttribute('data-search');
          var ok = terms.every(function (t) { return hay.indexOf(t) !== -1; }) &&
            has(li.getAttribute('data-layers'), state.layer) &&
            has(li.getAttribute('data-spheres'), state.sphere) &&
            has(li.getAttribute('data-districts'), state.district);
          li.hidden = !ok;
          if (ok) shown++;
        });
        var filtered = terms.length || state.layer.length || state.sphere.length || state.district.length;
        count.textContent = (filtered ? 'Найдено: ' : 'Всего записей: ') + shown;
        none.hidden = shown !== 0;
        reset.hidden = !filtered;
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', state[b.dataset.group].indexOf(b.dataset.value) !== -1 ? 'true' : 'false');
        });
        syncUrl();
      }
      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          var list = state[b.dataset.group], i = list.indexOf(b.dataset.value);
          if (i === -1) list.push(b.dataset.value); else list.splice(i, 1);
          apply();
        });
      });
      reset.addEventListener('click', function () { state.layer = []; state.sphere = []; state.district = []; q.value = ''; apply(); });
      q.addEventListener('input', apply);

      var params = new URLSearchParams(location.search);
      state.layer = (params.get('period') || '').split(',').filter(Boolean);
      state.sphere = (params.get('sfera') || '').split(',').filter(Boolean);
      state.district = (params.get('rayon') || '').split(',').filter(Boolean);
      q.value = params.get('q') || '';
      apply();
    })();
  </script>
</Base>
