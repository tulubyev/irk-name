---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { getPersons, districtsOf } from '../lib/persons';
import { siteLd, biographies } from '../lib/seo';
import { SPHERES, SPHERE_FAMILY, ERAS, DISTRICTS, DISTRICT_ORDER, isCity, type SphereKey, type EraKey } from '../lib/taxonomy';
const persons = await getPersons();
const sphereCounts = (Object.keys(SPHERES) as SphereKey[])
  .map((k) => ({ k, n: persons.filter((p) => p.data.spheres.includes(k)).length }));
// Все 42 города и района области: сначала города, затем районы, по алфавиту; пустые — неактивны
const districtCounts = DISTRICT_ORDER
  .map((k) => ({ k, n: persons.filter((p) => districtsOf(p.data).includes(k)).length }));
const cityCounts = districtCounts.filter(({ k }) => isCity(k));
const rajonCounts = districtCounts.filter(({ k }) => !isCity(k));
const eraCounts = (Object.keys(ERAS) as EraKey[])
  .map((k) => ({ k, n: persons.filter((p) => p.data.era === k).length }))
  .filter((x) => x.n > 0);
// Подписи для строки «Найдено: …»
const labels = { era: ERAS, sphere: SPHERES, district: DISTRICTS };
const description = `Знаменитые люди Иркутска и Иркутской области: ${biographies(persons.length)} учёных, писателей, декабристов, купцов, врачей и военных — годы жизни, чем известны, источники.`;
const jsonLd = siteLd(description);
---
<Base title="Знаменитые люди Иркутска и Иркутской области — Иркутяне" description={description} jsonLd={jsonLd}>
  <h1 class="sr-only">Знаменитые люди Иркутска и Иркутской области</h1>
  <div class="filters" id="filters">
    <label for="q" style="position:absolute;left:-9999px">Поиск по имени, сфере или месту</label>
    <input id="q" class="search" type="search" placeholder="Поиск: имя, сфера, место…" autocomplete="off" />
    <details class="dd" data-group="sphere">
      <summary>Занятие<span class="dd-count"></span></summary>
      <div class="dd-panel" role="group" aria-label="Занятие">
        <label class="dd-all"><input type="checkbox" data-all="sphere" /> Выбрать все</label>
        {sphereCounts.map(({ k, n }) => (
          <label class={`fam-${SPHERE_FAMILY[k]}${n === 0 ? ' disabled' : ''}`} title={n === 0 ? 'Записей пока нет — предложите персону' : undefined}>
            <input type="checkbox" data-group="sphere" value={k} disabled={n === 0} /><span class="swatch"></span> {SPHERES[k]} <span class="n">{n}</span>
          </label>
        ))}
        <div class="dd-actions"><button type="button" data-clear="sphere">Очистить</button></div>
      </div>
    </details>
    <details class="dd" data-group="district">
      <summary>Место<span class="dd-count"></span></summary>
      <div class="dd-panel" role="group" aria-label="Место">
        <label class="dd-all"><input type="checkbox" data-all="district" /> Выбрать все</label>
        {[['Города', cityCounts], ['Районы', rajonCounts]].map(([title, list]) => (
          <>
            <div class="dd-sub">{title}</div>
            {(list as typeof districtCounts).map(({ k, n }) => (
              <label class={n === 0 ? 'disabled' : undefined} title={n === 0 ? 'Записей пока нет — предложите персону' : undefined}>
                <input type="checkbox" data-group="district" value={k} disabled={n === 0} /> {DISTRICTS[k]} <span class="n">{n}</span>
              </label>
            ))}
          </>
        ))}
        <div class="dd-actions"><button type="button" data-clear="district">Очистить</button></div>
      </div>
    </details>
    <details class="dd" data-group="era">
      <summary>Время<span class="dd-count"></span></summary>
      <div class="dd-panel" role="group" aria-label="Время">
        <label class="dd-all"><input type="checkbox" data-all="era" /> Выбрать все</label>
        {eraCounts.map(({ k, n }) => (
          <label><input type="checkbox" data-group="era" value={k} /> {ERAS[k]} <span class="n">{n}</span></label>
        ))}
        <div class="dd-actions"><button type="button" data-clear="era">Очистить</button></div>
      </div>
    </details>
    <button type="button" id="reset" class="dd-reset" hidden>Сбросить все фильтры</button>
  </div>

  <p id="count" class="empty" aria-live="polite">Всего записей: {persons.length}</p>
  <script type="application/json" id="filter-labels" set:html={JSON.stringify(labels)} />
  <ul class="cards" id="list">
    {persons.map((p) => <PersonCard person={p} />)}
  </ul>
  <nav id="pager" class="pager" aria-label="Страницы" hidden></nav>
  <p id="none" class="empty" hidden>Ничего не найдено. Попробуйте убрать часть фильтров или <a href="/predlozhit/">предложите персону</a>.</p>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var items = Array.prototype.slice.call(document.querySelectorAll('#list .card'));
      var boxes = Array.prototype.slice.call(document.querySelectorAll('#filters input[type=checkbox][data-group]'));
      var dropdowns = Array.prototype.slice.call(document.querySelectorAll('#filters details.dd'));
      var count = document.getElementById('count');
      var none = document.getElementById('none');
      var reset = document.getElementById('reset');
      var PARAM = { sphere: 'sfera', district: 'rayon', era: 'vek' };
      var TITLE = { era: 'Время', sphere: 'Занятие', district: 'Место' };
      var LABELS = JSON.parse(document.getElementById('filter-labels').textContent);

      // Перемешивание карточек: Fisher-Yates shuffle
      function shuffle(arr) {
        for (var i = arr.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var temp = arr[i];
          arr[i] = arr[j];
          arr[j] = temp;
        }
        return arr;
      }

      // Перемешиваем карточки при первой загрузке (если нет параметров фильтрации в URL)
      var params = new URLSearchParams(location.search);
      var hasFilters = params.has('vek') || params.has('sfera') || params.has('rayon') || params.has('q') || params.has('str');
      if (!hasFilters) {
        items = shuffle(items);
        var listEl = document.getElementById('list');
        items.forEach(function (li) { listEl.appendChild(li); });
      }

      function selected(group) {
        return boxes.filter(function (b) { return b.dataset.group === group && b.checked; }).map(function (b) { return b.value; });
      }
      function has(attr, list) {
        if (!list.length) return true;
        var vals = (attr || '').split(' ');
        return list.some(function (v) { return vals.indexOf(v) !== -1; });
      }
      // Постраничная выдача: на странице ровно столько карточек, сколько помещается на экран
      var list = document.getElementById('list');
      var pager = document.getElementById('pager');
      var matched = [];
      var page = 1;
      var perPage = 12;
      function measure() {
        var cols = getComputedStyle(list).gridTemplateColumns.split(' ').filter(Boolean).length || 1;
        var probe = matched.length ? matched.slice(0, 12) : items.slice(0, 12);
        var was = probe.map(function (li) { return li.hidden; });
        probe.forEach(function (li) { li.hidden = false; });
        var h = Math.max.apply(null, probe.map(function (li) { return li.getBoundingClientRect().height; })) || 200;
        probe.forEach(function (li, i) { li.hidden = was[i]; });
        var gap = parseFloat(getComputedStyle(list).rowGap) || 0;
        var ft = document.querySelector('footer.site');
        var foot = ft ? ft.offsetHeight : 90;
        var top = list.getBoundingClientRect().top + window.scrollY;
        var free = window.innerHeight - top - foot - 64;
        var rows = Math.max(2, Math.floor((free + gap) / (h + gap)));
        perPage = cols * rows;
      }
      function pageList(n, cur) {
        var out = [], last = 0;
        for (var i = 1; i <= n; i++) {
          if (i === 1 || i === n || Math.abs(i - cur) <= 1) {
            if (last && i - last > 1) out.push(null);
            out.push(i); last = i;
          }
        }
        return out;
      }
      function renderPager(total) {
        pager.hidden = total <= 1;
        pager.textContent = '';
        if (total <= 1) return;
        function btn(label, target, opts) {
          var b = document.createElement('button');
          b.type = 'button'; b.textContent = label;
          if (opts && opts.cur) { b.className = 'cur'; b.setAttribute('aria-current', 'page'); }
          if (opts && opts.aria) b.setAttribute('aria-label', opts.aria);
          if (opts && opts.off) b.disabled = true;
          else b.addEventListener('click', function () { go(target); });
          pager.appendChild(b);
        }
        btn('←', page - 1, { aria: 'Предыдущая страница', off: page === 1 });
        pageList(total, page).forEach(function (n) {
          if (n === null) { var s = document.createElement('span'); s.textContent = '…'; pager.appendChild(s); }
          else btn(String(n), n, { cur: n === page });
        });
        btn('→', page + 1, { aria: 'Следующая страница', off: page === total });
      }
      function render() {
        var total = Math.max(1, Math.ceil(matched.length / perPage));
        page = Math.min(Math.max(page, 1), total);
        var visible = {};
        matched.slice((page - 1) * perPage, page * perPage).forEach(function (li) { visible[li.id] = true; });
        items.forEach(function (li) { li.hidden = !visible[li.id]; });
        renderPager(total);
      }
      function go(n) {
        page = n; render(); syncUrl();
        window.scrollTo({ top: 0 });
      }
      items.forEach(function (li, i) { li.id = li.id || 'p' + i; });

      var fromFilter = true;
      function apply() {
        var state = { era: selected('era'), sphere: selected('sphere'), district: selected('district') };
        var terms = q.value.toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean);
        var shown = 0;
        matched = [];
        items.forEach(function (li) {
          var hay = li.getAttribute('data-search');
          var ok = terms.every(function (t) { return hay.indexOf(t) !== -1; }) &&
            has(li.getAttribute('data-era'), state.era) &&
            has(li.getAttribute('data-spheres'), state.sphere) &&
            has(li.getAttribute('data-districts'), state.district);
          if (ok) matched.push(li);
        });
        shown = matched.length;
        if (fromFilter) page = 1;
        measure();
        render();
        var filtered = terms.length || state.era.length || state.sphere.length || state.district.length;
        var parts = [];
        Object.keys(PARAM).forEach(function (g) {
          if (!state[g].length) return;
          var avail = boxes.filter(function (b) { return b.dataset.group === g && !b.disabled; }).length;
          parts.push(TITLE[g] + ': ' + (state[g].length === avail ? 'все' : state[g].map(function (v) { return LABELS[g][v] || v; }).join(', ')));
        });
        if (q.value.trim()) parts.push('поиск «' + q.value.trim() + '»');
        count.textContent = filtered ? 'Найдено: ' + shown + ' — ' + parts.join('; ') : 'Всего записей: ' + shown;
        none.hidden = shown !== 0;
        reset.hidden = !filtered;
        dropdowns.forEach(function (d) {
          var n = state[d.dataset.group].length;
          d.querySelector('.dd-count').textContent = n ? String(n) : '';
          d.classList.toggle('active', n > 0);
          // «Выбрать все»: отмечено, если выбраны все доступные; частично — если некоторые
          var all = d.querySelector('[data-all]');
          var avail = boxes.filter(function (b) { return b.dataset.group === d.dataset.group && !b.disabled; });
          all.checked = n > 0 && n === avail.length;
          all.indeterminate = n > 0 && n < avail.length;
        });
        syncUrl();
      }
      function syncUrl() {
        var p = new URLSearchParams();
        Object.keys(PARAM).forEach(function (g) { var v = selected(g); if (v.length) p.set(PARAM[g], v.join(',')); });
        if (q.value) p.set('q', q.value);
        if (page > 1) p.set('str', String(page));
        var s = p.toString();
        try { history.replaceState(null, '', location.pathname + (s ? '?' + s : '')); } catch (e) {}
      }

      boxes.forEach(function (b) { b.addEventListener('change', apply); });
      document.querySelectorAll('#filters [data-all]').forEach(function (all) {
        all.addEventListener('change', function () {
          boxes.forEach(function (b) { if (b.dataset.group === all.dataset.all && !b.disabled) b.checked = all.checked; });
          apply();
        });
      });
      document.querySelectorAll('[data-clear]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          boxes.forEach(function (b) { if (b.dataset.group === btn.dataset.clear) b.checked = false; });
          apply();
        });
      });
      reset.addEventListener('click', function () { boxes.forEach(function (b) { b.checked = false; }); q.value = ''; apply(); });
      q.addEventListener('input', apply);

      // Открыт только один список; закрытие по клику вне и по Escape
      dropdowns.forEach(function (d) {
        d.addEventListener('toggle', function () {
          if (!d.open) return;
          dropdowns.forEach(function (o) { if (o !== d) o.open = false; });
          // если список не помещается справа — открываем его влево от кнопки
          var panel = d.querySelector('.dd-panel');
          panel.classList.remove('to-left');
          if (panel.getBoundingClientRect().right > document.documentElement.clientWidth - 8) panel.classList.add('to-left');
        });
      });
      document.addEventListener('click', function (e) {
        dropdowns.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        dropdowns.forEach(function (d) { if (d.open) { d.open = false; d.querySelector('summary').focus(); } });
      });

      // Восстановление состояния из адреса (?vek=…&sfera=…&rayon=…&q=…)
      var params = new URLSearchParams(location.search);
      Object.keys(PARAM).forEach(function (g) {
        var vals = (params.get(PARAM[g]) || '').split(',').filter(Boolean);
        boxes.forEach(function (b) { if (b.dataset.group === g && vals.indexOf(b.value) !== -1 && !b.disabled) b.checked = true; });
      });
      q.value = params.get('q') || '';
      apply();
      fromFilter = false;
      var startPage = parseInt(params.get('str') || '1', 10);
      if (startPage > 1) { page = startPage; render(); syncUrl(); }

      var resizeTimer;
      function relayout() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          var first = matched.indexOf(items.filter(function (li) { return !li.hidden; })[0]);
          measure();
          page = first < 0 ? 1 : Math.floor(first / perPage) + 1;
          render();
        }, 150);
      }
      window.addEventListener('resize', relayout);
      window.addEventListener('load', relayout);
    })();
  </script>
</Base>
