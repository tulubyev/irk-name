{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "zod/v4": [
        "./node_modules/zod/v4"
      ]
    }
  },
  "include": [
    "src",
    "../src/lib/person-schema.ts",
    "../src/lib/taxonomy.ts",
    "../src/lib/operator.ts"
  ]
}
