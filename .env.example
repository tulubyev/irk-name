# Скопируйте в .env на сервере и подставьте реальные значения. .env в git не коммитится.

# --- Traefik (значения сверены с vps-server-infra: traefik v2.11, web/websecure, letsencrypt) ---
TRAEFIK_NETWORK=traefik-public   # внешняя docker-сеть Traefik на VPS
TRAEFIK_ENTRYPOINT_HTTP=web      # entrypoint :80
TRAEFIK_ENTRYPOINT_HTTPS=websecure  # entrypoint :443
TRAEFIK_CERTRESOLVER=letsencrypt # имя certresolver в конфиге Traefik

# --- Домены ---
SITE_HOST=irk.name
CDN_HOST=cdn.irk.name

# --- Сайт ---
PUBLIC_CDN_URL=https://cdn.irk.name

# --- S3 (Beget) — публичное чтение для картинок ---
S3_ENDPOINT=https://s3.example.beget.cloud   # эндпоинт из панели Beget
S3_HOST=s3.example.beget.cloud               # то же без https:// (для nginx cdn)
S3_REGION=ru1
S3_BUCKET=irk-name-media
S3_FORCE_PATH_STYLE=true

# --- Ключи нужны ТОЛЬКО скрипту загрузки (scripts/upload-media.mjs), не контейнерам.
# Храните в переменных окружения / GitHub Secrets, никогда в репозитории.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Админка /admin (DEPLOY.md, раздел «Админка») ---
# COMPOSE_PROFILES=admin                 # раскомментируйте, чтобы запускать админку
# ADMIN_PASSWORD_HASH=                   # node admin/hash-password.mjs (сам пароль нигде не хранится)
# ADMIN_SESSION_SECRET=                  # openssl rand -hex 32
# GITHUB_TOKEN=                          # fine-grained token: только tulubyev/irk-name, Contents: Read and write
